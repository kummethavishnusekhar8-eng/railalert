# Port to run the server on
PORT=3000

# Nodemailer / SMTP Configuration (for Email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="RailAlert Bot" <your-email@gmail.com>

# Twilio Configuration (for SMS & WhatsApp alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# RapidAPI IRCTC Live API (Optional for real railway queries)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
